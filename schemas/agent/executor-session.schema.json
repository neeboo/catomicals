{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catomicals.dev/schemas/agent/executor-session.schema.json",
  "title": "Catomicals executor session",
  "description": "Versioned public session metadata shared by the desktop executor registry and renderer preload bridge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "protocol_session_id",
    "provider",
    "state",
    "capabilities",
    "mcp",
    "permission_scopes",
    "working_directory",
    "restart_impact"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "protocol_session_id": { "$ref": "./common.schema.json#/$defs/uuid" },
    "native_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "provider": { "$ref": "./common.schema.json#/$defs/provider" },
    "state": {
      "enum": ["idle", "running", "completed", "interrupted", "failed", "disposed"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "send",
        "interrupt",
        "status",
        "dispose",
        "resume",
        "model_selection",
        "reasoning_effort",
        "mcp",
        "wallet_approval",
        "signing",
        "broadcast"
      ],
      "properties": {
        "create": { "const": true },
        "send": { "const": true },
        "interrupt": { "const": true },
        "status": { "const": true },
        "dispose": { "const": true },
        "resume": { "type": "boolean" },
        "model_selection": { "type": "boolean" },
        "reasoning_effort": { "type": "boolean" },
        "mcp": { "type": "boolean" },
        "wallet_approval": { "const": false },
        "signing": { "const": false },
        "broadcast": { "const": false }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "transport", "services", "tool_names"],
      "properties": {
        "enabled": { "type": "boolean" },
        "transport": { "enum": ["stdio", "http-oauth"] },
        "services": {
          "type": "array",
          "items": { "enum": ["catomicals-config", "catomicals-wallet"] },
          "uniqueItems": true
        },
        "tool_names": {
          "type": "array",
          "items": { "$ref": "./common.schema.json#/$defs/agentToolName" },
          "uniqueItems": true
        }
      }
    },
    "permission_scopes": {
      "type": "array",
      "items": { "$ref": "./common.schema.json#/$defs/permissionScope" },
      "uniqueItems": true
    },
    "model": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reasoning_effort": { "$ref": "./common.schema.json#/$defs/reasoningEffort" },
    "working_directory": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "restart_impact": { "enum": ["none", "plugin", "desktop"] },
    "last_error": { "enum": ["interrupted", "process-failed", "spawn-failed", "output-limit"] }
  },
  "oneOf": [
    {
      "properties": {
        "capabilities": {
          "properties": { "mcp": { "const": true } }
        },
        "mcp": {
          "properties": {
            "enabled": { "const": true },
            "services": { "const": ["catomicals-config", "catomicals-wallet"] },
            "tool_names": {
              "const": [
                "list_plugins",
                "read_plugin_manifest",
                "read_plugin_settings_schema",
                "read_plugin_health",
                "validate_plugin_settings_patch",
                "create_plugin_settings_intent",
                "add_chat_message",
                "cancel_signing_intent",
                "check_protected_trade",
                "create_transaction_intent",
                "get_chat_state",
                "get_wallet_status",
                "inspect_transaction",
                "list_signing_intents",
                "read_signing_intent"
              ]
            }
          }
        },
        "permission_scopes": {
          "const": [
            "wallet.status.read",
            "wallet.intent.read",
            "wallet.intent.create",
            "wallet.intent.cancel",
            "wallet.chat.read",
            "wallet.chat.append",
            "wallet.transaction.inspect",
            "wallet.trade.verify",
            "plugin.catalog.read",
            "plugin.manifest.read",
            "plugin.settings_schema.read",
            "plugin.health.read",
            "plugin.settings.validate",
            "plugin.settings_intent.create"
          ]
        }
      }
    },
    {
      "properties": {
        "capabilities": {
          "properties": { "mcp": { "const": false } }
        },
        "mcp": {
          "properties": {
            "enabled": { "const": false },
            "services": { "maxItems": 0 },
            "tool_names": { "maxItems": 0 }
          }
        },
        "permission_scopes": { "maxItems": 0 }
      }
    }
  ]
}
