{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catomicals.dev/schemas/covhub/covhub-code-confirmation-v1.json",
  "title": "CovHub code confirmation v1",
  "description": "A CovHub code confirmation. `confirmed` may be emitted only when the artifact digest and size match the supplied bytes and every required test is pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "confirmation_id",
    "canvas_digest",
    "artifact",
    "tests",
    "status",
    "confirmed_at",
    "content_digest"
  ],
  "properties": {
    "schema": { "const": "covhub.code-confirmation/v1" },
    "confirmation_id": { "type": "string", "minLength": 1 },
    "canvas_digest": { "$ref": "#/$defs/sha256Digest" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" }
    },
    "status": { "enum": ["confirmed", "failed", "inconclusive"] },
    "confirmed_at": { "$ref": "#/$defs/rfc3339" },
    "content_digest": { "$ref": "#/$defs/sha256Digest" }
  },
  "$defs": {
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type", "sha256", "size_bytes"],
      "properties": {
        "kind": { "const": "unsigned-transaction-material" },
        "media_type": { "const": "application/vnd.kaspa.transaction-review+binary" },
        "sha256": { "$ref": "#/$defs/sha256Digest" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "runner", "status", "evidence_digest"],
      "properties": {
        "test_id": { "type": "string" },
        "runner": { "type": "string" },
        "status": { "const": "pass" },
        "evidence_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    }
  }
}
