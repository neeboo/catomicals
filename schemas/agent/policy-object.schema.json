{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catomicals.dev/schemas/agent/policy-object.schema.json",
  "title": "Catomicals deterministic policy bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "document",
    "policy_hash",
    "artifacts",
    "artifact_set_digest",
    "test_vectors",
    "vector_set_digest",
    "validation_run"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "compiler_version": { "type": "string", "pattern": "^catomicals-policy-registry/[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "document": { "$ref": "#/$defs/policyDocument" },
    "policy_hash": { "$ref": "#/$defs/hash" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/policyArtifact" }
    },
    "artifact_set_digest": { "$ref": "#/$defs/hash" },
    "test_vectors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/policyTestVector" }
    },
    "vector_set_digest": { "$ref": "#/$defs/hash" },
    "validation_run": { "$ref": "#/$defs/validationRun" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hexBytes": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "canonicalization": {
      "const": "catomicals-policy-jcs-v1"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bitcoin_network", "deployment_profile", "op_cat"],
      "properties": {
        "bitcoin_network": { "const": "signet" },
        "deployment_profile": { "const": "bitcoin-inquisition-signet-v29.4-op-cat" },
        "op_cat": { "const": "required" }
      }
    },
    "issuanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "target_prefix",
        "total_supply",
        "successor_rule",
        "lane_count",
        "salt",
        "metadata_base64"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/hex32" },
        "target_prefix": { "type": "integer", "minimum": 0, "maximum": 32 },
        "total_supply": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "successor_rule": { "enum": ["recursive_issuer", "sharded_lanes"] },
        "lane_count": { "type": "integer", "minimum": 1, "maximum": 255 },
        "salt": { "$ref": "#/$defs/hex32" },
        "metadata_base64": { "type": "string", "contentEncoding": "base64", "maxLength": 5464 }
      }
    },
    "receiptInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "txid",
        "vout",
        "script_pubkey_hex",
        "item_sat_amount",
        "terms_hash",
        "item_id",
        "item_commitment",
        "lane",
        "sequence"
      ],
      "properties": {
        "txid": { "$ref": "#/$defs/hex32" },
        "vout": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "script_pubkey_hex": { "$ref": "#/$defs/hexBytes" },
        "item_sat_amount": { "type": "integer", "minimum": 1 },
        "terms_hash": { "$ref": "#/$defs/hex32" },
        "item_id": { "$ref": "#/$defs/hex32" },
        "item_commitment": { "$ref": "#/$defs/hex32" },
        "lane": { "type": "integer", "minimum": 0, "maximum": 255 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "listingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "seller_key",
        "seller_payout_script_hex",
        "price_sat",
        "creator_fee_script_hex",
        "creator_fee_sat",
        "cancel_script_hex",
        "expiry_height",
        "max_network_fee_sat"
      ],
      "properties": {
        "receipt": { "$ref": "#/$defs/receiptInput" },
        "seller_key": { "$ref": "#/$defs/hex32" },
        "seller_payout_script_hex": { "$ref": "#/$defs/hexBytes" },
        "price_sat": { "type": "integer", "minimum": 1 },
        "creator_fee_script_hex": { "$ref": "#/$defs/hexBytes" },
        "creator_fee_sat": { "type": "integer", "minimum": 1 },
        "cancel_script_hex": { "$ref": "#/$defs/hexBytes" },
        "expiry_height": { "type": "integer", "minimum": 1, "maximum": 499999999 },
        "max_network_fee_sat": { "type": "integer", "minimum": 1 }
      }
    },
    "issuanceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonicalization",
        "digest_algorithm",
        "network",
        "policy_kind",
        "name",
        "input"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "canonicalization": { "$ref": "#/$defs/canonicalization" },
        "digest_algorithm": { "$ref": "#/$defs/digestAlgorithm" },
        "network": { "$ref": "#/$defs/network" },
        "policy_kind": { "const": "catomicals-issuance-v1" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "input": { "$ref": "#/$defs/issuanceInput" }
      }
    },
    "listingDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonicalization",
        "digest_algorithm",
        "network",
        "policy_kind",
        "name",
        "input"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "canonicalization": { "$ref": "#/$defs/canonicalization" },
        "digest_algorithm": { "$ref": "#/$defs/digestAlgorithm" },
        "network": { "$ref": "#/$defs/network" },
        "policy_kind": { "const": "catomicals-fixed-price-listing-v1" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "input": { "$ref": "#/$defs/listingInput" }
      }
    },
    "policyDocument": {
      "oneOf": [
        { "$ref": "#/$defs/issuanceDocument" },
        { "$ref": "#/$defs/listingDocument" }
      ]
    },
    "candidateIssuanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "target_prefix",
        "total_supply",
        "successor_rule",
        "lane_count",
        "salt",
        "metadata_base64"
      ],
      "properties": {
        "item_id": { "type": "string" },
        "target_prefix": { "type": "integer" },
        "total_supply": { "type": "integer" },
        "successor_rule": { "enum": ["recursive_issuer", "sharded_lanes"] },
        "lane_count": { "type": "integer" },
        "salt": { "type": "string" },
        "metadata_base64": { "type": "string" }
      }
    },
    "candidateReceiptInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "txid",
        "vout",
        "script_pubkey_hex",
        "item_sat_amount",
        "terms_hash",
        "item_id",
        "item_commitment",
        "lane",
        "sequence"
      ],
      "properties": {
        "txid": { "type": "string" },
        "vout": { "type": "integer" },
        "script_pubkey_hex": { "type": "string" },
        "item_sat_amount": { "type": "integer" },
        "terms_hash": { "type": "string" },
        "item_id": { "type": "string" },
        "item_commitment": { "type": "string" },
        "lane": { "type": "integer" },
        "sequence": { "type": "integer" }
      }
    },
    "candidateListingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "seller_key",
        "seller_payout_script_hex",
        "price_sat",
        "creator_fee_script_hex",
        "creator_fee_sat",
        "cancel_script_hex",
        "expiry_height",
        "max_network_fee_sat"
      ],
      "properties": {
        "receipt": { "$ref": "#/$defs/candidateReceiptInput" },
        "seller_key": { "type": "string" },
        "seller_payout_script_hex": { "type": "string" },
        "price_sat": { "type": "integer" },
        "creator_fee_script_hex": { "type": "string" },
        "creator_fee_sat": { "type": "integer" },
        "cancel_script_hex": { "type": "string" },
        "expiry_height": { "type": "integer" },
        "max_network_fee_sat": { "type": "integer" }
      }
    },
    "candidateIssuanceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonicalization",
        "digest_algorithm",
        "network",
        "policy_kind",
        "name",
        "input"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "canonicalization": { "$ref": "#/$defs/canonicalization" },
        "digest_algorithm": { "$ref": "#/$defs/digestAlgorithm" },
        "network": { "$ref": "#/$defs/network" },
        "policy_kind": { "const": "catomicals-issuance-v1" },
        "name": { "type": "string" },
        "input": { "$ref": "#/$defs/candidateIssuanceInput" }
      }
    },
    "candidateListingDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonicalization",
        "digest_algorithm",
        "network",
        "policy_kind",
        "name",
        "input"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "canonicalization": { "$ref": "#/$defs/canonicalization" },
        "digest_algorithm": { "$ref": "#/$defs/digestAlgorithm" },
        "network": { "$ref": "#/$defs/network" },
        "policy_kind": { "const": "catomicals-fixed-price-listing-v1" },
        "name": { "type": "string" },
        "input": { "$ref": "#/$defs/candidateListingInput" }
      }
    },
    "candidateDocument": {
      "oneOf": [
        { "$ref": "#/$defs/candidateIssuanceDocument" },
        { "$ref": "#/$defs/candidateListingDocument" }
      ]
    },
    "policyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "content_ref",
        "content_hex",
        "content_digest"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lane": { "type": "integer", "minimum": 0, "maximum": 255 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content_ref": { "type": "string", "pattern": "^inline:.+$" },
        "content_hex": { "$ref": "#/$defs/hexBytes" },
        "content_digest": { "$ref": "#/$defs/hash" }
      }
    },
    "vectorInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "document"],
          "properties": {
            "operation": { "const": "compile_document" },
            "document": { "$ref": "#/$defs/candidateDocument" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "document", "claimed_policy_hash"],
          "properties": {
            "operation": { "const": "verify_policy_hash" },
            "document": { "$ref": "#/$defs/candidateDocument" },
            "claimed_policy_hash": { "$ref": "#/$defs/hash" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "artifact"],
          "properties": {
            "operation": { "const": "verify_artifact" },
            "artifact": { "$ref": "#/$defs/policyArtifact" }
          }
        }
      ]
    },
    "policyTestVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector_id", "input", "expected_accept"],
      "properties": {
        "vector_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "input": { "$ref": "#/$defs/vectorInput" },
        "expected_accept": { "type": "boolean" }
      }
    },
    "vectorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector_id", "expected_accept", "actual_accept", "passed"],
      "properties": {
        "vector_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "expected_accept": { "type": "boolean" },
        "actual_accept": { "type": "boolean" },
        "passed": { "type": "boolean" }
      }
    },
    "validationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_version",
        "policy_hash",
        "artifact_set_digest",
        "vector_set_digest",
        "results",
        "all_passed",
        "run_digest"
      ],
      "properties": {
        "compiler_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_hash": { "$ref": "#/$defs/hash" },
        "artifact_set_digest": { "$ref": "#/$defs/hash" },
        "vector_set_digest": { "$ref": "#/$defs/hash" },
        "results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/vectorResult" }
        },
        "all_passed": { "const": true },
        "run_digest": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
